diff --git a/include/hw/misc/virt_gpu.h b/include/hw/misc/virt_gpu.h
new file mode 100644
index 0000000..46a38a4
--- /dev/null
+++ b/include/hw/misc/virt_gpu.h
@@ -0,0 +1,55 @@
+/*
+ * In-QEMU GPU passthrough device for the ARM 'virt' machine.
+ *
+ * Exposes an 8MB+ RAM region (the glpass SPSC shm_region) at a fixed phys base.
+ * The guest's libGLESv2/libEGL shim maps it (GLPASS_SHM_PHYS=<base>) and writes
+ * a GL command stream into the c2h ring exactly as before — but now the CONSUMER
+ * is a render thread INSIDE qemu (ANGLE -> Metal), not the external glpass_serve
+ * process. This eliminates the fixed guest-RAM SHM carve-out (frees that RAM for
+ * procnto) and makes the GPU a real emulated device.
+ */
+#ifndef HW_MISC_VIRT_GPU_H
+#define HW_MISC_VIRT_GPU_H
+
+#include "hw/sysbus.h"
+#include "qemu/thread.h"
+
+#define TYPE_VIRT_GPU "virt-gpu"
+
+/*
+ * The QOM cast macro is named VIRT_GPU_DEV (not VIRT_GPU) to avoid colliding
+ * with the VIRT_GPU memmap enum entry in hw/arm/virt.h (same trick as the
+ * virt-keypad device). OBJECT_DECLARE_SIMPLE_TYPE derives the type name from
+ * the macro stem as TYPE_##stem, so alias it to our type string.
+ */
+#define TYPE_VIRT_GPU_DEV TYPE_VIRT_GPU
+OBJECT_DECLARE_SIMPLE_TYPE(VirtGpuState, VIRT_GPU_DEV)
+
+/* 12 MiB: 9 MiB rounded command rings plus a 2 MiB raw RGBA mailbox. */
+#define VIRT_GPU_RAM_SIZE 0x00c00000
+
+/* On-screen console geometry — MUST match SERVE_W/SERVE_H in
+ * host/glpass_gpu_device_gl.c (the offscreen FBO the renderer reads back). */
+#define VIRT_GPU_W 1024
+#define VIRT_GPU_H 480
+
+struct VirtGpuState {
+    SysBusDevice parent_obj;
+    MemoryRegion ram;     /* the shm_region, mapped at the device phys base */
+    void        *ram_ptr; /* host pointer to the same bytes the guest writes */
+    QemuThread   thread;  /* render thread (drains c2h; Phase 2: ANGLE dispatch) */
+    bool         running;
+
+    /* On-screen mirror of the rendered FBO for -display cocoa. The render
+     * thread fills 'fb' (xRGB8888, top-down) under fb_lock and schedules 'bh';
+     * the BH and the console gfx_update callback (both run on the QEMU main
+     * loop) blit 'fb' into the console's DisplaySurface. graphic_console is not
+     * thread-safe, so the render thread never touches the surface directly. */
+    QemuConsole *con;
+    QEMUBH      *bh;
+    QemuMutex    fb_lock;
+    uint8_t     *fb;       /* VIRT_GPU_W*VIRT_GPU_H*4 */
+    bool         fb_dirty;
+};
+
+#endif /* HW_MISC_VIRT_GPU_H */
diff --git a/include/hw/misc/virt_keypad.h b/include/hw/misc/virt_keypad.h
new file mode 100644
index 0000000..2059d0d
--- /dev/null
+++ b/include/hw/misc/virt_keypad.h
@@ -0,0 +1,55 @@
+/*
+ * Virtual keypad MMIO device for the ARM 'virt' machine.
+ *
+ * A simple sysbus MMIO device with a chardev (socket) frontend: a host GUI
+ * connects to the chardev and writes raw bytes; each byte is one keypad event
+ * code pushed into a FIFO and signalled to the guest via an IRQ. The guest
+ * reads the events through MMIO registers.
+ *
+ * This program is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU General Public License as published by the
+ * Free Software Foundation; either version 2 or (at your option) any later
+ * version.
+ */
+
+#ifndef HW_MISC_VIRT_KEYPAD_H
+#define HW_MISC_VIRT_KEYPAD_H
+
+#include "hw/sysbus.h"
+#include "chardev/char-fe.h"
+#include "qom/object.h"
+
+#define TYPE_VIRT_KEYPAD "virt-keypad"
+
+/*
+ * The QOM cast macro is named VIRT_KEYPAD_DEV (not VIRT_KEYPAD) to avoid
+ * colliding with the VIRT_KEYPAD memmap/irqmap enum entry in hw/arm/virt.h.
+ * OBJECT_DECLARE_SIMPLE_TYPE derives the type name from the macro stem as
+ * TYPE_##stem, so alias it to our type string here.
+ */
+#define TYPE_VIRT_KEYPAD_DEV TYPE_VIRT_KEYPAD
+OBJECT_DECLARE_SIMPLE_TYPE(VirtKeypadState, VIRT_KEYPAD_DEV)
+
+#define VIRT_KEYPAD_FIFO_SIZE 256
+
+/* MMIO register map (32-bit, little-endian) */
+#define VIRT_KEYPAD_REG_STATUS 0x00  /* R: bit0 = FIFO non-empty            */
+#define VIRT_KEYPAD_REG_DATA   0x04  /* R: pop one byte (0 if empty)        */
+#define VIRT_KEYPAD_REG_ID     0x08  /* R: magic 'KPQD' = 0x4B505144        */
+
+#define VIRT_KEYPAD_ID_MAGIC   0x4B505144  /* 'KPQD' */
+
+struct VirtKeypadState {
+    SysBusDevice parent;
+
+    MemoryRegion mmio;
+    qemu_irq irq;
+    CharBackend chr;
+
+    uint8_t fifo[VIRT_KEYPAD_FIFO_SIZE];
+    uint32_t head;
+    uint32_t tail;
+    uint32_t count;
+};
+
+#endif /* HW_MISC_VIRT_KEYPAD_H */
