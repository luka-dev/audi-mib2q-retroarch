diff --git a/hw/misc/virt_gpu.c b/hw/misc/virt_gpu.c
new file mode 100644
index 0000000..6bf7c2e
--- /dev/null
+++ b/hw/misc/virt_gpu.c
@@ -0,0 +1,210 @@
+/*
+ * In-QEMU GPU passthrough device for the ARM 'virt' machine — Phase 1.
+ *
+ * Phase 1 (this file): expose the glpass shm_region as a RAM BAR and run a
+ * render thread that performs the host handshake and DRAINS the c2h GL command
+ * ring (parsing [u16 op][u32 len][payload] frames) so the guest never blocks.
+ * No GL dispatch yet — Phase 2 links ANGLE and replays the stream.
+ *
+ * This program is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU General Public License version 2 or later.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/thread.h"
+#include "qemu/main-loop.h"
+#include "qapi/error.h"
+#include "hw/sysbus.h"
+#include "hw/misc/virt_gpu.h"
+#include "ui/console.h"
+#include "ui/surface.h"
+
+/* Mirror of guest/host shm.h — the SPSC region the guest shim writes. Keep in
+ * lockstep with that header. */
+#define SHM_MAGIC    0x47534852u   /* "GSHR" */
+#define SHM_VERSION  1u
+#define SHM_RING     (1u << 22)    /* 4 MiB per direction (power of two) */
+
+typedef struct {
+    volatile uint32_t magic, version;
+    volatile uint32_t host_ready, guest_ready;
+    volatile uint32_t c2h_head, c2h_tail;   /* guest writes head, host writes tail */
+    volatile uint32_t h2c_head, h2c_tail;
+    uint32_t _pad[8];
+    uint8_t  c2h[SHM_RING];
+    uint8_t  h2c[SHM_RING];
+} shm_region;
+
+/* Provided by host/glpass_gpu_device_gl.c (archived into libglpassrender_gl.a):
+ * inits an offscreen CGL/OpenGL context (the complete backend_gl renderer) and
+ * runs glp_serve_shm over the region. (The ANGLE/Metal variant — glpass_gpu_render
+ * in glpass_gpu_device.c — is kept in git for the future Metal path.) */
+extern int glpass_gpu_render_gl(void *shm);
+
+/* Present hook: the renderer calls this (on the render thread) once per
+ * eglSwapBuffers with the freshly read-back RGB frame. See glpass_gpu_set_present
+ * in host/glpass_gpu_device_gl.c. */
+extern void glpass_gpu_set_present(
+    void (*cb)(void *u, const unsigned char *rgb, int w, int h), void *u);
+
+/*
+ * On-screen presentation.
+ *
+ * Threading: the renderer runs on virt_gpu's own pthread (virt_gpu_render), NOT
+ * a QEMU thread, and reads pixels with glReadPixels — all host-side. QEMU's
+ * graphic_console / DisplaySurface API must only be touched from the main loop.
+ * So virt_gpu_present (render thread) only converts pixels into the device-owned
+ * 'fb' staging buffer under fb_lock and kicks a bottom-half. virt_gpu_bh and the
+ * console gfx_update callback both run on the main loop and do the surface blit.
+ */
+
+/* MAIN LOOP ONLY. Caller must hold fb_lock. Copies staging fb into the console
+ * surface. Returns true if a repaint should follow. */
+static bool virt_gpu_blit_locked(VirtGpuState *s)
+{
+    DisplaySurface *surface;
+    if (!s->fb_dirty || !s->con) {
+        return false;
+    }
+    surface = qemu_console_surface(s->con);
+    if (!surface ||
+        surface_width(surface) != VIRT_GPU_W ||
+        surface_height(surface) != VIRT_GPU_H) {
+        return false;
+    }
+    /* surface is PIXMAN_x8r8g8b8, stride may exceed w*4 — copy row by row. */
+    for (int y = 0; y < VIRT_GPU_H; y++) {
+        memcpy((uint8_t *)surface_data(surface) + (size_t)y * surface_stride(surface),
+               s->fb + (size_t)y * VIRT_GPU_W * 4, (size_t)VIRT_GPU_W * 4);
+    }
+    s->fb_dirty = false;
+    return true;
+}
+
+/* Bottom-half scheduled by virt_gpu_present: runs on the main loop. */
+static void virt_gpu_bh(void *opaque)
+{
+    VirtGpuState *s = opaque;
+    bool painted;
+    qemu_mutex_lock(&s->fb_lock);
+    painted = virt_gpu_blit_locked(s);
+    qemu_mutex_unlock(&s->fb_lock);
+    if (painted) {
+        dpy_gfx_update_full(s->con);
+    }
+}
+
+/* Console refresh tick (main loop): repaint from the latest staging frame even
+ * if the BH coalesced, and on first display / window re-expose. */
+static void virt_gpu_gfx_update(void *opaque)
+{
+    virt_gpu_bh(opaque);
+}
+
+static void virt_gpu_invalidate(void *opaque)
+{
+    VirtGpuState *s = opaque;
+    dpy_gfx_update_full(s->con);
+}
+
+static const GraphicHwOps virt_gpu_gfx_ops = {
+    .invalidate = virt_gpu_invalidate,
+    .gfx_update = virt_gpu_gfx_update,
+};
+
+/* RENDER THREAD. rgb is W*H*3, bottom-up (GL origin); pack into top-down
+ * xRGB8888 staging, then wake the main loop. */
+static void virt_gpu_present(void *u, const unsigned char *rgb, int w, int h)
+{
+    VirtGpuState *s = u;
+    if (w != VIRT_GPU_W || h != VIRT_GPU_H || !s->fb) {
+        return;
+    }
+    qemu_mutex_lock(&s->fb_lock);
+    for (int y = 0; y < h; y++) {
+        const unsigned char *src = rgb + (size_t)(h - 1 - y) * w * 3; /* flip */
+        uint32_t *dst = (uint32_t *)(s->fb + (size_t)y * w * 4);
+        for (int x = 0; x < w; x++) {
+            dst[x] = 0xff000000u | ((uint32_t)src[0] << 16) |
+                     ((uint32_t)src[1] << 8) | (uint32_t)src[2];
+            src += 3;
+        }
+    }
+    s->fb_dirty = true;
+    qemu_mutex_unlock(&s->fb_lock);
+    qemu_bh_schedule(s->bh);
+}
+
+static void *virt_gpu_render(void *opaque)
+{
+    VirtGpuState *s = opaque;
+    shm_region *r = (shm_region *)s->ram_ptr;
+
+    /* Wait for the guest shim to publish the ring (it stores magic LAST). */
+    while (s->running && (r->magic != SHM_MAGIC || r->version != SHM_VERSION)) {
+        g_usleep(200000);
+    }
+    if (!s->running) {
+        return NULL;
+    }
+    fprintf(stderr, "[virt-gpu] guest SHM ring up (magic=GSHR); starting ANGLE renderer\n");
+    /*
+     * Hand the region to the in-qemu ANGLE renderer. glpass_gpu_render() calls
+     * glp_angle_init() then glp_serve_shm(), which sets host_ready and runs the
+     * GL command consumer (rendering to an offscreen Metal pbuffer, dumping PPM
+     * frames) until the guest closes the channel.
+     */
+    glpass_gpu_render_gl(s->ram_ptr);
+    return NULL;
+}
+
+static void virt_gpu_realize(DeviceState *dev, Error **errp)
+{
+    VirtGpuState *s = VIRT_GPU_DEV(dev);
+    Error *err = NULL;
+
+    memory_region_init_ram(&s->ram, OBJECT(s), "virt-gpu-ram",
+                           VIRT_GPU_RAM_SIZE, &err);
+    if (err) {
+        error_propagate(errp, err);
+        return;
+    }
+    s->ram_ptr = memory_region_get_ram_ptr(&s->ram);
+    memset(s->ram_ptr, 0, VIRT_GPU_RAM_SIZE);
+    sysbus_init_mmio(SYS_BUS_DEVICE(dev), &s->ram);
+
+    /* On-screen output: register a graphic console so the rendered FBO shows in
+     * the -display cocoa window. All console setup runs here on the main loop. */
+    qemu_mutex_init(&s->fb_lock);
+    s->fb = g_malloc0((size_t)VIRT_GPU_W * VIRT_GPU_H * 4);
+    s->con = graphic_console_init(dev, 0, &virt_gpu_gfx_ops, s);
+    qemu_console_resize(s->con, VIRT_GPU_W, VIRT_GPU_H);
+    s->bh = qemu_bh_new(virt_gpu_bh, s);
+    glpass_gpu_set_present(virt_gpu_present, s);
+
+    s->running = true;
+    qemu_thread_create(&s->thread, "virt-gpu-render",
+                       virt_gpu_render, s, QEMU_THREAD_JOINABLE);
+}
+
+static void virt_gpu_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    dc->realize = virt_gpu_realize;
+    dc->user_creatable = false;   /* the machine instantiates it */
+}
+
+static const TypeInfo virt_gpu_info = {
+    .name          = TYPE_VIRT_GPU,
+    .parent        = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(VirtGpuState),
+    .class_init    = virt_gpu_class_init,
+};
+
+static void virt_gpu_register_types(void)
+{
+    type_register_static(&virt_gpu_info);
+}
+
+type_init(virt_gpu_register_types)
diff --git a/hw/misc/virt_keypad.c b/hw/misc/virt_keypad.c
new file mode 100644
index 0000000..9fad0d5
--- /dev/null
+++ b/hw/misc/virt_keypad.c
@@ -0,0 +1,186 @@
+/*
+ * Virtual keypad MMIO device for the ARM 'virt' machine.
+ *
+ * A sysbus MMIO device at a fixed base with a chardev (socket) frontend.
+ * The host connects to the chardev and writes raw bytes; each byte is one
+ * keypad event code that is pushed into a FIFO and signalled via an IRQ.
+ * The guest reads the events out via MMIO.
+ *
+ * Register map (32-bit, little-endian):
+ *   0x00 STATUS (R): bit0 = FIFO non-empty (data available)
+ *   0x04 DATA   (R): pop one byte from the FIFO (0 if empty); the IRQ is
+ *                    deasserted once the FIFO drains to empty
+ *   0x08 ID     (R): magic 0x4B505144 ('KPQD') for guest probing
+ * Writes are accepted as an ACK and lower the IRQ.
+ *
+ * This program is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU General Public License as published by the
+ * Free Software Foundation; either version 2 or (at your option) any later
+ * version.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qapi/error.h"
+#include "hw/irq.h"
+#include "hw/sysbus.h"
+#include "hw/qdev-properties.h"
+#include "hw/qdev-properties-system.h"
+#include "chardev/char-fe.h"
+#include "hw/misc/virt_keypad.h"
+
+static void virt_keypad_update_irq(VirtKeypadState *s)
+{
+    qemu_set_irq(s->irq, s->count > 0);
+}
+
+static uint64_t virt_keypad_read(void *opaque, hwaddr offset, unsigned size)
+{
+    VirtKeypadState *s = opaque;
+    uint32_t val = 0;
+
+    switch (offset) {
+    case VIRT_KEYPAD_REG_STATUS:
+        val = (s->count > 0) ? 1 : 0;
+        break;
+    case VIRT_KEYPAD_REG_DATA:
+        if (s->count > 0) {
+            val = s->fifo[s->head];
+            s->head = (s->head + 1) % VIRT_KEYPAD_FIFO_SIZE;
+            s->count--;
+            /* Reading the last byte deasserts the IRQ. */
+            virt_keypad_update_irq(s);
+            /* The FIFO has room again; let the chardev resume. */
+            qemu_chr_fe_accept_input(&s->chr);
+        }
+        break;
+    case VIRT_KEYPAD_REG_ID:
+        val = VIRT_KEYPAD_ID_MAGIC;
+        break;
+    default:
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "%s: bad read offset 0x%" HWADDR_PRIx "\n",
+                      __func__, offset);
+        break;
+    }
+
+    return val;
+}
+
+static void virt_keypad_write(void *opaque, hwaddr offset,
+                              uint64_t value, unsigned size)
+{
+    VirtKeypadState *s = opaque;
+
+    switch (offset) {
+    case VIRT_KEYPAD_REG_STATUS:
+    case VIRT_KEYPAD_REG_DATA:
+        /* Treat any write as an ACK: lower the IRQ. */
+        qemu_irq_lower(s->irq);
+        break;
+    default:
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "%s: bad write offset 0x%" HWADDR_PRIx "\n",
+                      __func__, offset);
+        break;
+    }
+}
+
+static const MemoryRegionOps virt_keypad_ops = {
+    .read = virt_keypad_read,
+    .write = virt_keypad_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .impl.min_access_size = 4,
+    .impl.max_access_size = 4,
+};
+
+static int virt_keypad_can_receive(void *opaque)
+{
+    VirtKeypadState *s = opaque;
+
+    /* Accept as many bytes as we have free FIFO slots. */
+    return VIRT_KEYPAD_FIFO_SIZE - s->count;
+}
+
+static void virt_keypad_receive(void *opaque, const uint8_t *buf, int size)
+{
+    VirtKeypadState *s = opaque;
+    int i;
+
+    for (i = 0; i < size; i++) {
+        if (s->count >= VIRT_KEYPAD_FIFO_SIZE) {
+            /* FIFO full: drop the byte. */
+            break;
+        }
+        s->fifo[s->tail] = buf[i];
+        s->tail = (s->tail + 1) % VIRT_KEYPAD_FIFO_SIZE;
+        s->count++;
+    }
+
+    /* Temporary trace for the smoke test (safe to leave in). */
+    fprintf(stderr, "virt-keypad: received %d byte(s), fifo count=%u, "
+            "first=0x%02x\n", size, s->count, size > 0 ? buf[0] : 0);
+
+    /* Pulse/raise the IRQ to tell the guest data is available. */
+    virt_keypad_update_irq(s);
+}
+
+static void virt_keypad_event(void *opaque, QEMUChrEvent event)
+{
+    /* Nothing to do on open/close/break for now. */
+}
+
+static void virt_keypad_realize(DeviceState *dev, Error **errp)
+{
+    VirtKeypadState *s = VIRT_KEYPAD_DEV(dev);
+
+    memory_region_init_io(&s->mmio, OBJECT(dev), &virt_keypad_ops, s,
+                          "virt-keypad", 0x1000);
+    sysbus_init_mmio(SYS_BUS_DEVICE(dev), &s->mmio);
+    sysbus_init_irq(SYS_BUS_DEVICE(dev), &s->irq);
+
+    qemu_chr_fe_set_handlers(&s->chr,
+                             virt_keypad_can_receive,
+                             virt_keypad_receive,
+                             virt_keypad_event,
+                             NULL, s, NULL, true);
+}
+
+static void virt_keypad_reset(DeviceState *dev)
+{
+    VirtKeypadState *s = VIRT_KEYPAD_DEV(dev);
+
+    s->head = 0;
+    s->tail = 0;
+    s->count = 0;
+    qemu_irq_lower(s->irq);
+}
+
+static Property virt_keypad_properties[] = {
+    DEFINE_PROP_CHR("chardev", VirtKeypadState, chr),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
+static void virt_keypad_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->desc = "Virtual keypad MMIO device (socket-backed event injector)";
+    dc->realize = virt_keypad_realize;
+    dc->reset = virt_keypad_reset;
+    device_class_set_props(dc, virt_keypad_properties);
+}
+
+static const TypeInfo virt_keypad_info = {
+    .name          = TYPE_VIRT_KEYPAD,
+    .parent        = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(VirtKeypadState),
+    .class_init    = virt_keypad_class_init,
+};
+
+static void virt_keypad_register_types(void)
+{
+    type_register_static(&virt_keypad_info);
+}
+
+type_init(virt_keypad_register_types)
