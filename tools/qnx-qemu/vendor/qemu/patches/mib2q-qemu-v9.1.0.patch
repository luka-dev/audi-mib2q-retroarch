+static void create_virt_keypad(const VirtMachineState *vms, MemoryRegion *mem)
+{
+    char *nodename;
+    hwaddr base = vms->memmap[VIRT_KEYPAD].base;
+    hwaddr size = vms->memmap[VIRT_KEYPAD].size;
+    int irq = vms->irqmap[VIRT_KEYPAD];
+    MachineState *ms = MACHINE(vms);
+    DeviceState *dev = qdev_new(TYPE_VIRT_KEYPAD);
+    SysBusDevice *s = SYS_BUS_DEVICE(dev);
+    Chardev *chr;
+
+    /*
+     * The host attaches a socket via "-chardev socket,id=keypad,...".
+     * Look it up by the fixed id "keypad" and wire it to the device. If no
+     * such chardev was given, the device still exists (guest can probe the ID
+     * register) but simply never receives events.
+     */
+    chr = qemu_chr_find("keypad");
+    if (chr) {
+        qdev_prop_set_chr(dev, "chardev", chr);
+    }
+
+    sysbus_realize_and_unref(s, &error_fatal);
+    memory_region_add_subregion(mem, base, sysbus_mmio_get_region(s, 0));
+    sysbus_connect_irq(s, 0, qdev_get_gpio_in(vms->gic, irq));
+
+    nodename = g_strdup_printf("/virt-keypad@%" PRIx64, base);
+    qemu_fdt_add_subnode(ms->fdt, nodename);
+    qemu_fdt_setprop_string(ms->fdt, nodename, "compatible", "qemu,virt-keypad");
+    qemu_fdt_setprop_sized_cells(ms->fdt, nodename, "reg", 2, base, 2, size);
+    qemu_fdt_setprop_cells(ms->fdt, nodename, "interrupts",
+                           GIC_FDT_IRQ_TYPE_SPI, irq,
+                           GIC_FDT_IRQ_FLAGS_LEVEL_HI);
+    g_free(nodename);
+}
+
+static void create_virt_gpu(const VirtMachineState *vms, MemoryRegion *mem)
+{
+    hwaddr base = vms->memmap[VIRT_GPU].base;
+    DeviceState *dev = qdev_new(TYPE_VIRT_GPU);
+    SysBusDevice *s = SYS_BUS_DEVICE(dev);
+
+    /*
+     * The shm_region is exposed as a RAM BAR at VIRT_GPU.base. The guest shim
+     * maps it (GLPASS_SHM_PHYS=base) and writes the GL command ring; the
+     * device's render thread consumes it inside qemu.
+     */
+    sysbus_realize_and_unref(s, &error_fatal);
+    memory_region_add_subregion(mem, base, sysbus_mmio_get_region(s, 0));
+}
+
+/*
+ * A sysbus (MMIO) OHCI USB host controller — QNX 6.5 ARM has no PCI, but ships
+ * a full USB stack (io-usb + devu-ohci + devn-asix/devnp-ecmplus), exactly like
+ * the real MIB2Q which networks over a USB D-Link adapter. The guest drives this
+ * standard OHCI at VIRT_USB.base/irq; attach a "usb-net" (CDC-ECM) to its bus to
+ * give the guest real host<->guest networking. See memory guest-networking-landscape.
+ */
+static void create_virt_usb(const VirtMachineState *vms, MemoryRegion *mem)
+{
+    char *nodename;
+    hwaddr base = vms->memmap[VIRT_USB].base;
+    hwaddr size = vms->memmap[VIRT_USB].size;
+    int irq = vms->irqmap[VIRT_USB];
+    MachineState *ms = MACHINE(vms);
+    DeviceState *dev = qdev_new("sysbus-ohci");
+    SysBusDevice *s = SYS_BUS_DEVICE(dev);
+
+    qdev_prop_set_uint32(dev, "num-ports", 3);
+    sysbus_realize_and_unref(s, &error_fatal);
+    memory_region_add_subregion(mem, base, sysbus_mmio_get_region(s, 0));
+    sysbus_connect_irq(s, 0, qdev_get_gpio_in(vms->gic, irq));
+
+    nodename = g_strdup_printf("/usb@%" PRIx64, base);
+    qemu_fdt_add_subnode(ms->fdt, nodename);
+    qemu_fdt_setprop_string(ms->fdt, nodename, "compatible", "generic-ohci");
+    qemu_fdt_setprop_sized_cells(ms->fdt, nodename, "reg", 2, base, 2, size);
+    qemu_fdt_setprop_cells(ms->fdt, nodename, "interrupts",
+                           GIC_FDT_IRQ_TYPE_SPI, irq,
+                           GIC_FDT_IRQ_FLAGS_LEVEL_HI);
+    g_free(nodename);
+}
+
 static void create_virtio_devices(const VirtMachineState *vms)
 {
     int i;
@@ -2393,6 +2484,12 @@ static void machvirt_init(MachineState *machine)
         create_gpio_devices(vms, VIRT_SECURE_GPIO, secure_sysmem);
     }
 
+    create_virt_keypad(vms, sysmem);
+
+    create_virt_gpu(vms, sysmem);
+
+    create_virt_usb(vms, sysmem);
