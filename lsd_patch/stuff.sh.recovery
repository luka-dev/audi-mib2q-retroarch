#!/bin/ksh
# RA RECOVERY (runs directly from SD via finalScript.sh during M.I.B. SWDL, on the RCC).
# Removes the bad HMI override jar so LSD boots stock again. $2 = medium path (SD).
SD=${2:-/net/mmx/fs/sda0}
LOG="$SD/ra_recovery.log"
{
    echo "=== RA recovery via stuff.sh (HW=$1 medium=$2) ==="
    removed=0
    for APP in /net/mmx/mnt/app /mnt/app; do
        JARS="$APP/eso/hmi/lsd/jars"
        [ -d "$JARS" ] || { echo "skip: no $JARS"; continue; }
        mount -uw "$APP" 2>/dev/null
        echo "jars in $JARS:"; ls -l "$JARS" 2>&1 | grep -i '\.jar'
        if [ -f "$JARS/ra_mhi2q.jar" ]; then
            rm -f "$JARS/ra_mhi2q.jar" && { echo "OK: removed $JARS/ra_mhi2q.jar"; removed=1; } || echo "FAIL: rm $JARS/ra_mhi2q.jar"
        fi
        rm -f "$JARS/ra_games_hook.jar" "$JARS/ra_scene.jar" 2>/dev/null
    done
    echo "RESULT removed=$removed"
    echo "=== done ==="
} >> "$LOG" 2>&1
sync
exit 0
