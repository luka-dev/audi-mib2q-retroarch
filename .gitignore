/out/
.DS_Store

# Local HU diagnostics and one-off inspection binaries are intentionally kept
# outside Git. Release/runtime binaries live under build/ instead.
/diagnostics/
/src/retroarch.stripped
/tools/qnx_egl_configs

# User-supplied games and firmware stay local and are never published.
/build/macos-local/games/
/build/tests/
/build/*_libretro.so
/build/ppsspp-qemu-tests.log
/build/qnx-cxx-runtime-smoke*
/build/qnx-static-runtime/
/build/macos-local/system/
/build/sd_card/retroarch/gba/
/build/sd_card/retroarch/n64/
/build/sd_card/retroarch/ps1/
/build/sd_card/retroarch/roms/
/build/sd_card/retroarch/system/

# Mutable runtime data belongs to the removable SD card, not the repository.
/build/macos-local/downloads/
/build/macos-local/logs/
/build/macos-local/playlists/
/build/macos-local/saves/
/build/macos-local/screenshots/
/build/macos-local/states/
/build/sd_card/retroarch/downloads/
/build/sd_card/retroarch/logs/
/build/sd_card/retroarch/playlists/
/build/sd_card/retroarch/saves/
/build/sd_card/retroarch/screenshots/
/build/sd_card/retroarch/states/

# Mesa checkouts and QNX Freedreno static builds are reproducible from
# tools/qnx-freedreno (pinned commit + mesa-qnx.patch); ~1.5 GB, not tracked.
/build/mesa-freedreno-*-src/
/build/mesa-freedreno-src/
/build/mesa-build-tools*/
/build/qnx-freedreno/mesa-static*/
